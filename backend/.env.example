# Backend Environment Variables
# Copy this to .env and fill in your actual API keys

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/sunmarke_ai

# LLM API Keys (All offer free tiers)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxx  # For embeddings (text-embedding-3-small)
GEMINI_API_KEY=xxxxxxxxxxxxxxx     # Google Gemini - Free tier available
KIMI_API_KEY=xxxxxxxxxxxxxxx       # Kimi (Moonshot) - Free tier available  
DEEPSEEK_API_KEY=xxxxxxxxxxxxxxx   # DeepSeek - Free tier available

# Server Configuration
PORT=8000
ENV=development

# CORS (in production, restrict to your frontend domain)
CORS_ORIGINS=*
